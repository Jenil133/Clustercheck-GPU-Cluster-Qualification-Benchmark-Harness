{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://clustercheck.invalid/schemas/node-run.schema.json", "title": "ClusterCheck node-local run", "type": "object",
  "required": ["schema_version", "run_id", "started_at", "completed_at", "provenance", "synthetic_notice", "node", "inventory", "checks", "overall_status", "config_sha256"],
  "properties": {
    "schema_version": {"const": "1.1"}, "run_id": {"type": "string"}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
    "provenance": {"enum": ["measured", "synthetic"]}, "synthetic_notice": {"type": ["string", "null"]}, "node": {"type": "string"}, "inventory": {"type": "object"},
    "checks": {"type": "array", "minItems": 1}, "overall_status": {"enum": ["pass", "fail", "error", "skipped"]}, "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }, "additionalProperties": false
}
